---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Steven Fourie - Java and DevOps Engineer. Systems, deployment, infrastructure.",
} = Astro.props;

const canonical = "https://sf13.dev/";
const siteName = "Steven Fourie";
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Steven Fourie" />
    <meta name="keywords" content="Java developer, DevOps engineer, Spring Boot, Kubernetes, CI/CD, platform engineering, Breda, Netherlands" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0b0e" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${canonical}og-image.png`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonical}og-image.png`} />
    <meta name="twitter:creator" content="@stvnfx" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Analytics -->
    <script defer src="https://u.sf13.dev/script.js" data-website-id="c761ef5d-857f-45fd-9e95-1ef5be85096e"></script>
    <script defer src="https://u.sf13.dev/recorder.js" data-website-id="c761ef5d-857f-45fd-9e95-1ef5be85096e"></script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Steven Fourie",
      "url": canonical,
      "jobTitle": "Senior Software Developer",
      "worksFor": {
        "@type": "Organization",
        "name": "Pinkroccade Local Government"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Breda",
        "addressCountry": "NL"
      },
      "sameAs": [
        "https://github.com/stvnfx",
        "https://www.linkedin.com/in/steven-fourie-56719a6b"
      ],
      "knowsAbout": ["Java", "Spring Boot", "Kubernetes", "DevOps", "CI/CD", "Platform Engineering"]
    })} />
  </head>
  <body>
    <div class="scanline-bar"></div>
    <slot />
  </body>
</html>
