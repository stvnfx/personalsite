<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ascii = document.getElementById("hero-ascii");
    if (!ascii) return;

    let timeout: ReturnType<typeof setTimeout>;

    function glitchBurst() {
      const chars = "!@#$%^&*()_+-=[]{}|;':\",./<>?ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789█▓▒░│┤╡╢╖╕╣║╗╝╜╛┐┴┬├─┼╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌";

      const lines = ascii.textContent?.split("\n") || [];
      if (!lines.length) return;

      const glitch = document.createElement("pre");
      glitch.className = "ascii-art ascii-glitch-overlay";
      glitch.setAttribute("aria-hidden", "true");
      glitch.style.cssText = `
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        z-index: 10;
        pointer-events: none;
        overflow: hidden;
      `;
      ascii.parentNode?.insertBefore(glitch, ascii.nextSibling);

      let frame = 0;
      const maxFrames = 6 + Math.floor(Math.random() * 6);

      const interval = setInterval(() => {
        if (frame >= maxFrames) {
          clearInterval(interval);
          glitch.remove();
          return;
        }

        const glitchLines = [...lines];
        const numZones = 1 + Math.floor(Math.random() * 2);
        for (let z = 0; z < numZones; z++) {
          const row = Math.floor(Math.random() * glitchLines.length);
          const lineStr = glitchLines[row];
          if (!lineStr) continue;

          const start = Math.floor(Math.random() * lineStr.length);
          const len = 2 + Math.floor(Math.random() * 12);
          const mutated = lineStr.slice(0, start) +
            Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join("") +
            lineStr.slice(start + len);

          glitchLines[row] = mutated;
        }

        glitch.textContent = glitchLines.join("\n");
        glitch.style.opacity = String(0.3 + Math.random() * 0.5);

        if (frame > maxFrames - 3) {
          glitch.style.opacity = String(0.1 * (maxFrames - frame));
        }

        frame++;
      }, 40 + Math.random() * 60);

      timeout = setTimeout(glitchBurst, 2000 + Math.random() * 6000);
    }

    setTimeout(glitchBurst, 1500);
  });
</script>

<style>
  .ascii-hero {
    margin-bottom: 1rem;
    user-select: none;
    position: relative;
    display: inline-block;
    overflow: hidden;
  }
  .ascii-art {
    font-family: 'Gohu', monospace;
    font-size: 10px;
    line-height: 1;
    color: var(--color-accent);
    white-space: pre;
    overflow: hidden;
    letter-spacing: 0;
    -webkit-font-smoothing: none;
    display: block;
    margin: 0;
    padding: 0;
  }
  .ascii-glitch-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
    text-shadow: 0.5px 0 #cc6666, -0.5px 0 #93ffd7;
    margin: 0;
    padding: 0;
    z-index: 10;
    overflow: hidden;
  }
  .fg-white { color: #e0e0e0; }
  .fg-bright-white { color: #ffffff; }
  .fg-red { color: #cc6666; }
  .bg-black { background-color: #0a0b0e; }
  .bg-white { background-color: #e0e0e0; }
  .tagline {
    text-align: center;
    color: var(--color-fg-dim);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 0.25rem;
  }
  @media (max-width: 700px) {
    .ascii-art {
      font-size: 5px;
    }
    .tagline {
      font-size: 9px;
    }
  }
</style>
