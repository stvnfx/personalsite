---
---

<div class="ascii-hero">
  <div class="ascii-wrap">
    <img
      id="hero-ascii"
      src="/hero-ascii.png"
      alt="STEVEN FOURIE ASCII art"
      class="ascii-img"
    />
    <div id="hero-ascii-glitch" class="ascii-glitch" aria-hidden="true"></div>
  </div>
  <p class="tagline">
    s y s t e m s . d e p l o y m e n t . i n f r a s t r u c t u r e
  </p>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const img = document.getElementById("hero-ascii") as HTMLImageElement | null;
    const glitch = document.getElementById("hero-ascii-glitch") as HTMLDivElement | null;
    if (!img || !glitch) return;

    let timeout: ReturnType<typeof setTimeout>;

    function glitchBurst() {
      const chars = "!@#$%^&*()_+-=[]{}|;':\",./<>?ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789█▓▒░│┤╡╢╖╕╣║╗╝╜╛┐└┴┬├─┼╞╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌";

      const width = Math.floor(img.naturalWidth / 6);
      const height = Math.floor(img.naturalHeight / 11);
      const lines: string[] = [];
      for (let y = 0; y < height; y++) {
        let line = "";
        for (let x = 0; x < width; x++) {
          line += chars[Math.floor(Math.random() * chars.length)];
        }
        lines.push(line);
      }

      glitch.textContent = "";
      const pre = document.createElement("pre");
      pre.textContent = lines.join("\n");
      pre.style.cssText = `
        font-family: monospace;
        font-size: 11px;
        line-height: 1;
        color: var(--color-accent);
        white-space: pre;
        -webkit-font-smoothing: none;
        letter-spacing: 0;
        text-shadow: 0.5px 0 #cc6666, -0.5px 0 #93ffd7;
      `;
      glitch.appendChild(pre);

      let frame = 0;
      const maxFrames = 6 + Math.floor(Math.random() * 6);
      const interval = setInterval(() => {
        if (frame >= maxFrames) {
          clearInterval(interval);
          glitch.innerHTML = "";
          glitch.style.opacity = "0";
          return;
        }

        const glitchLines = [...lines];
        const numZones = 1 + Math.floor(Math.random() * 2);
        for (let z = 0; z < numZones; z++) {
          const row = Math.floor(Math.random() * glitchLines.length);
          const lineStr = glitchLines[row];
          if (!lineStr) continue;

          const start = Math.floor(Math.random() * lineStr.length);
          const len = 2 + Math.floor(Math.random() * 12);
          const mutated = lineStr.slice(0, start) +
            Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join("") +
            lineStr.slice(start + len);

          glitchLines[row] = mutated;
        }

        const pre2 = document.createElement("pre");
        pre2.textContent = glitchLines.join("\n");
        pre2.style.cssText = (pre as HTMLPreElement).style.cssText;
        glitch.innerHTML = "";
        glitch.appendChild(pre2);

        glitch.style.opacity = String(0.3 + Math.random() * 0.5);

        if (Math.random() < 0.3) {
          glitch.style.transform = `translate(${(Math.random() - 0.5) * 3}px, ${(Math.random() - 0.5) * 2}px)`;
        }
        if (frame > maxFrames - 3) {
          glitch.style.opacity = String(0.1 * (maxFrames - frame));
        }

        frame++;
      }, 40 + Math.random() * 60);

      timeout = setTimeout(glitchBurst, 2000 + Math.random() * 6000);
    }

    setTimeout(glitchBurst, 1500);
  });
</script>

<style>
  .ascii-hero {
    margin-bottom: 1rem;
    user-select: none;
  }
  .ascii-wrap {
    position: relative;
    display: inline-block;
  }
  .ascii-img {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  .ascii-glitch {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ascii-glitch pre {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--color-accent);
    white-space: pre;
    -webkit-font-smoothing: none;
    letter-spacing: 0;
    text-shadow: 0.5px 0 #cc6666, -0.5px 0 #93ffd7;
  }
  .tagline {
    text-align: center;
    color: var(--color-fg-dim);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 0.25rem;
  }
  @media (max-width: 700px) {
    .ascii-glitch pre {
      font-size: 5.5px;
    }
    .tagline {
      font-size: 9px;
    }
  }
</style>
