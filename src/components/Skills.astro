---
const skills = [
  {
    category: "Languages",
    items: ["Java (17, 21, 25)", "TypeScript", "SQL", "Python", "Bash"],
  },
  {
    category: "Frameworks",
    items: ["Spring Boot", "Spring Batch", "Quarkus", "Java EE", "React", "NodeJS"],
  },
  {
    category: "Infrastructure",
    items: ["Kubernetes", "Docker", "AWS", "Azure", "Terraform", "Ansible"],
  },
  {
    category: "Data & Messaging",
    items: ["PostgreSQL", "MySQL", "MS SQL", "RabbitMQ", "IBM MQ"],
  },
  {
    category: "Tooling",
    items: ["GitLab CI/CD", "TeamCity", "Jenkins", "Grafana", "Prometheus"],
  },
];
---

<section class="py-20 px-6 border-t border-border bg-cream-dark/50">
  <div class="max-w-6xl mx-auto">
    <p class="text-rust font-mono text-sm uppercase tracking-wider mb-4">
      Skills
    </p>
    <h2 class="font-serif text-4xl md:text-5xl font-bold text-ink mb-12">
      The usual suspects.
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {skills.map((s) => (
        <div>
          <h3 class="font-mono text-sm text-ink-muted uppercase tracking-wider mb-3">
            {s.category}
          </h3>
          <ul class="space-y-2">
            {s.items.map((item) => (
              <li class="text-ink-light text-sm">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
