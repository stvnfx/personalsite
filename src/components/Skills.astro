---
const skills = [
  { category: "languages", items: ["Java (17, 21, 25)", "TypeScript", "SQL", "Python", "Bash"] },
  { category: "frameworks", items: ["Spring Boot", "Spring Batch", "Quarkus", "Java EE", "React", "NodeJS"] },
  { category: "infra", items: ["Kubernetes", "Docker", "AWS", "Azure", "Terraform", "Ansible"] },
  { category: "data", items: ["PostgreSQL", "MySQL", "MS SQL", "RabbitMQ", "IBM MQ"] },
  { category: "tooling", items: ["GitLab CI/CD", "TeamCity", "Jenkins", "Grafana", "Prometheus"] },
];
---

<section id="skills" class="section-box">
  <div class="section-inner">
    <p class="prompt-line">
      <span class="prompt-symbol">$</span> ls -la /usr/local/skills/
    </p>
    <div class="skills-grid">
      {skills.map((s) => (
        <div class="terminal-box skill-group">
          <p class="skill-category">{s.category}/</p>
          {s.items.map((item) => (
            <p class="skill-item">{item}</p>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .skill-group {
    padding: 0.75rem 1rem;
  }
  .skill-category {
    color: var(--color-warn);
    font-size: 11px;
    margin-bottom: 0.35rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .skill-item {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
  }
  .skill-item::before {
    content: "  ";
  }
</style>
