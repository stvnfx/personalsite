---
const skills = [
  { category: "languages", items: ["Java (17, 21, 25)", "TypeScript", "SQL", "Python", "Bash"] },
  { category: "frameworks", items: ["Spring Boot", "Spring Batch", "Quarkus", "Java EE", "React", "NodeJS"] },
  { category: "infra", items: ["Kubernetes", "Docker", "AWS", "Azure", "Terraform", "Ansible"] },
  { category: "data", items: ["PostgreSQL", "MySQL", "MS SQL", "RabbitMQ", "IBM MQ"] },
  { category: "tooling", items: ["GitLab CI/CD", "TeamCity", "Jenkins", "Grafana", "Prometheus"] },
];
---

<section id="skills" class="section">
  <h2>Skills</h2>
  <div class="skills-grid">
    {skills.map((s) => (
      <div class="skill-group">
        <p class="skill-category">{s.category}</p>
        {s.items.map((item) => (
          <p class="skill-item">{item}</p>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-tx);
    margin-bottom: 1.25rem;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.25rem;
  }
  .skill-group {
    padding: 0.75rem 0;
  }
  .skill-category {
    color: var(--color-tx);
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 0.5rem;
  }
  .skill-item {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-tx-2);
  }
  .skill-item::before {
    content: "\2014\00a0";
    color: var(--color-tx-3);
  }
</style>
