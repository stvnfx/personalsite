<header class="nav-header">
  <nav class="nav-inner">
    <a href="#top" class="nav-home">Steven Fourie</a>
    <div class="nav-links">
      <a href="#about">about</a>
      <a href="#experience">experience</a>
      <a href="#skills">skills</a>
      <a href="#contact">contact</a>
      <span class="theme-toggle" id="theme-toggle" role="switch" aria-label="Toggle dark mode" title="Toggle dark mode">
        <div class="theme-toggle-slide"></div>
        <div class="theme-toggle-switch"></div>
      </span>
    </div>
  </nav>
</header>

<script is:inline>
  (function() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const html = document.documentElement;

    function applyTheme(theme) {
      html.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      toggle.setAttribute('aria-checked', theme === 'dark');
    }

    applyTheme(html.getAttribute('data-theme'));

    toggle.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });
  })();
</script>

