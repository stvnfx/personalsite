---
const jobs = [
  {
    company: "Pinkroccade Local Government",
    role: "Senior Software Developer",
    location: "'s-Hertogenbosch, NL",
    period: "Jan 2026 - Present",
    description: "Working on the iBurgerzaken platform. Building features and fixing integrations between Blueriq and the Core Java platform.",
    tech: ["Java 17/21/25", "Spring Boot", "Kubernetes", "PostgreSQL", "GitLab CI/CD"],
  },
  {
    company: "Interfile",
    role: "Senior Software Developer",
    location: "Fourways, ZA",
    period: "Jan 2023 - Jan 2024",
    description: "Government services work. Part of the modernisation team migrating old Java EE systems to Spring Boot and React. Also trained junior developers.",
    tech: ["Java EE", "Spring Boot", "Kubernetes", "PrimeFaces", "MSSQL"],
  },
  {
    company: "Acrontum",
    role: "Senior Software Developer",
    location: "Munich, DE",
    period: "Jan 2023 - Jan 2024",
    description: "Contracted to BMW for the AOS2 (After Sale Service) team. Built backend services with Quarkus.",
    tech: ["Java", "Quarkus", "Kubernetes", "NodeJS"],
  },
  {
    company: "Marketplace Superheroes",
    role: "Senior Developer / Team Lead",
    location: "Wrexham, UK",
    period: "Sep 2021 - Dec 2022",
    description: "Led a team on a warehousing platform. Handled infrastructure, CI/CD pipelines, and built internal monitoring dashboards.",
    tech: ["Java", "Spring Boot", "AWS", "Terraform", "Ansible", "Grafana"],
  },
  {
    company: "Qode Healthcare",
    role: "Senior Software Developer",
    location: "Pretoria, ZA",
    period: "Mar 2018 - Sep 2021",
    description: "Backend work for public and private healthcare. Led the public healthcare division. Built iOS apps and internal HR tools.",
    tech: ["Java", "Spring Boot", "Azure", "Swift", "Kubernetes"],
  },
  {
    company: "Comb Communications",
    role: "Software Developer",
    location: "Midrand, ZA",
    period: "2015 - 2018",
    description: "Access control and security software. Built Java EE backends, managed servers, and handled disaster recovery.",
    tech: ["Java EE", "Spring", "Docker", "Apache NiFi", "Ansible"],
  },
];
---

<section id="experience" class="py-20 px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <p class="text-rust font-mono text-sm uppercase tracking-wider mb-4">
      Experience
    </p>
    <div class="flex items-baseline justify-between mb-12">
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-ink">
        Where I have worked.
      </h2>
    </div>
    <div class="space-y-0">
      {jobs.map((job, i) => (
        <div class:list={[
          "py-8",
          i !== jobs.length - 1 && "border-b border-border",
        ]}>
          <div class="grid md:grid-cols-[200px_1fr] gap-4 md:gap-8">
            <div class="text-sm text-ink-muted">
              {job.period}
            </div>
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                <h3 class="font-serif text-xl font-semibold text-ink">
                  {job.company}
                </h3>
                <span class="text-sm text-ink-muted">
                  {job.role}
                </span>
              </div>
              <p class="text-sm text-ink-muted mb-3">
                {job.location}
              </p>
              <p class="text-ink-light text-sm leading-relaxed mb-4">
                {job.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {job.tech.map((t) => (
                  <span class="text-xs px-2 py-1 bg-cream-dark text-ink-muted rounded">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
