---
const jobs = [
  {
    company: "Pinkroccade Local Government",
    role: "Senior Software Developer",
    location: "'s-Hertogenbosch, NL",
    period: "2026-01 - Present",
    description: "iBurgerzaken platform. Feature development and Blueriq-Core Java integration fixes.",
    tech: ["Java 17,21,25", "Spring Boot", "Kubernetes", "PostgreSQL", "GitLab CI/CD"],
  },
  {
    company: "Interfile",
    role: "Senior Software Developer",
    location: "Fourways, ZA",
    period: "2023-01 - 2024-01",
    description: "Government services. Modernisation team migrating Java EE to Spring Boot and React. Trainer for junior developers.",
    tech: ["Java EE", "Spring Boot", "Kubernetes", "PrimeFaces", "MSSQL"],
  },
  {
    company: "Acrontum",
    role: "Senior Software Developer",
    location: "Munich, DE",
    period: "2023-01 - 2024-01",
    description: "Contracted to BMW for the AOS2 (After Sale Service) team. Backend services with Quarkus.",
    tech: ["Java", "Quarkus", "Kubernetes", "NodeJS"],
  },
  {
    company: "Marketplace Superheroes",
    role: "Senior Developer / Team Lead",
    location: "Wrexham, UK",
    period: "2021-09 - 2022-12",
    description: "Led team on warehousing platform. Infrastructure, CI/CD, internal monitoring dashboards.",
    tech: ["Java", "Spring Boot", "AWS", "Terraform", "Ansible", "Grafana"],
  },
  {
    company: "Qode Healthcare",
    role: "Senior Software Developer",
    location: "Pretoria, ZA",
    period: "2018-03 - 2021-09",
    description: "Backend for public and private healthcare. Led public healthcare division. iOS apps and internal HR tools.",
    tech: ["Java", "Spring Boot", "Azure", "Swift", "Kubernetes"],
  },
  {
    company: "Comb Communications",
    role: "Software Developer",
    location: "Midrand, ZA",
    period: "2015 - 2018",
    description: "Access control and security. Java EE backends, server management, disaster recovery.",
    tech: ["Java EE", "Spring", "Docker", "Apache NiFi", "Ansible"],
  },
];
---

<section id="experience" class="section-box">
  <div class="section-inner">
    <p class="prompt-line">
      <span class="prompt-symbol">$</span> cat /var/log/employment.history
    </p>

    {jobs.map((job) => (
      <div class="terminal-box job-entry">
        <div class="job-header">
          <span class="job-date">[{job.period}]</span>
          <span class="job-company">{job.company}</span>
          <span class="job-role">&mdash; {job.role}</span>
        </div>
        <p class="job-location">{job.location}</p>
        <p>{job.description}</p>
        <div class="tag-row">
          {job.tech.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .job-entry {
    margin-bottom: 0.75rem;
  }
  .job-header {
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .job-date {
    color: var(--color-accent);
    font-size: 12px;
  }
  .job-company {
    color: var(--color-fg-bright);
    font-weight: bold;
  }
  .job-role {
    color: var(--color-fg-dim);
    font-size: 12px;
  }
  .job-location {
    color: var(--color-fg-dim);
    font-size: 11px;
    margin: 0 0 0.5rem;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .tag {
    font-size: 10px;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border-light);
    color: var(--color-fg-dim);
  }
</style>
